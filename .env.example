# Park & Shine frontend — local environment template
# Copy to .env.local (gitignored). All NEXT_PUBLIC_* values are inlined at build time.

# ── Backend ──────────────────────────────────────────────────────────────────
# Local backend (park_n_shine_be) defaults to :3001. Use :4000 for `bun mock-server.ts`.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Firebase (customer accounts: email/password + Google) ────────────────────
# Public web config. If left empty the app falls back to the parknshine-9c1c1
# project values hardcoded in src/lib/firebase.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Payments (Midtrans) ──────────────────────────────────────────────────────
# Sandbox client key from https://dashboard.sandbox.midtrans.com → Settings → Access Keys
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# TEMPORARY workaround mirroring backend MIDTRANS_CHARGE_MODE=snap.
# true = skip the payment-method picker and go straight to Snap.
NEXT_PUBLIC_SKIP_PAYMENT_METHOD_SELECTION=false
# NEXT_PUBLIC_PAYMENT_POLL_INTERVAL_MS=

# ── Realtime + push ──────────────────────────────────────────────────────────
# Must match ENABLE_REALTIME / ENABLE_PUSH_NOTIFICATIONS on the backend.
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_PUSH_ENABLED=false
# Must equal the backend's VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Monitoring ───────────────────────────────────────────────────────────────
# Leave empty locally; Sentry is a no-op without a DSN.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ── Misc ─────────────────────────────────────────────────────────────────────
# Fallback WhatsApp support number if GET /v1/settings is unreachable.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Middleware cookie-JWT gate for /admin and /crew. Keep false (see docs/HANDOVER.md).
NEXT_PUBLIC_COOKIE_AUTH=false
# Only read when NEXT_PUBLIC_COOKIE_AUTH=true. Must match the backend secrets.
# ADMIN_JWT_SECRET=
# CREW_JWT_SECRET=

# Dev-only: where the backend writes local uploads (STORAGE_PROVIDER=local).
# UPLOAD_DIR=/tmp/park-n-shine-uploads
